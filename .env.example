# Copy to .env, which Git ignores, and fill in. Without SENTRY_DSN the shop runs without Sentry.
SENTRY_DSN=
SENTRY_ENVIRONMENT=demo
# The Resend API key receipts and account emails are sent with, and the address account emails come from.
RESEND_API_KEY=
EMAIL_FROM=Shop <no-reply@shop-mail-test.com>
# The database compose.yaml starts.
DATABASE_URL=postgresql://shop:shop-demo-pass@127.0.0.1:55433/shop
